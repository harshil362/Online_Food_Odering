<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin_Site2.master.cs" Inherits="Online_Food_Odering.admin.Admin_Site2" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <link rel="icon" type="image/png" href="../images/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="css/admin.css" />
    <link rel="stylesheet" href="css/responsive.css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
  <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | FoodieHub Admin</title>
  <link rel="icon" type="image/png" href="../images/favicon.png" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="css/admin.css">
  <link rel="stylesheet" href="css/responsive.css">
</head>
<body class="admin-body">
  <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->  <!-- SIDEBAR START -->

  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=150&q=80" alt="FoodieHub">
      <span>FoodieHub</span>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-label">Main</div>
      <a href="dashboard.aspx" class="nav-item active"><i class="fa-solid fa-gauge-high"></i>Dashboard</a>
      <div class="nav-label">Management</div>
      <a href="orders.aspx" class="nav-item"><i class="fa-solid fa-bag-shopping"></i>Orders</a>
      <a href="menu.aspx" class="nav-item"><i class="fa-solid fa-utensils"></i>Menu</a>
      <a href="categories.aspx" class="nav-item"><i class="fa-solid fa-layer-group"></i>Categories</a>
      <div class="nav-label">Users</div>
      <a href="customers.aspx" class="nav-item"><i class="fa-solid fa-users"></i>Customers</a>
      <div class="nav-label">Business</div>
      <a href="coupons.aspx" class="nav-item"><i class="fa-solid fa-ticket"></i>Coupons</a>
      <a href="payments.aspx" class="nav-item"><i class="fa-solid fa-credit-card"></i>Payments</a>
      <a href="delivery.aspx" class="nav-item"><i class="fa-solid fa-truck"></i>Delivery</a>
      <div class="nav-label">Insights</div>
      <a href="reviews.aspx" class="nav-item"><i class="fa-solid fa-star"></i>Reviews</a>
      <a href="reports.aspx" class="nav-item"><i class="fa-solid fa-chart-line"></i>Reports</a>
      <div class="nav-label">System</div>
      <a href="settings.aspx" class="nav-item"><i class="fa-solid fa-gear"></i>Settings</a>
    </nav>
    <div class="sidebar-footer">
      <a href="#" onclick="adminLogout()" class="nav-item"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
    </div>
  </aside>
  <!-- SIDEBAR END -->

  <!-- Topbar -->
  <!-- TOPBAR START -->

  <header class="admin-topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
      <div class="topbar-search"><i class="fa-solid fa-search"></i><input type="text" placeholder="Search anything..."></div>
    </div>
    <div class="topbar-right">
      <div class="topbar-icon"><i class="fa-solid fa-bell"></i><span class="topbar-badge">3</span></div>
      <div style="position:relative">
        <div class="admin-profile" onclick="toggleProfileDropdown()">
          <img src="https://i.pravatar.cc/40?img=68" alt="Admin">
          <span>Admin</span>
          <i class="fa-solid fa-chevron-down" style="font-size:.65rem;color:#6c757d"></i>
        </div>
        <div class="profile-dropdown">
          <a href="settings.aspx"><i class="fa-solid fa-user"></i>My Profile</a>
          <a href="settings.aspx"><i class="fa-solid fa-gear"></i>Settings</a>
          <div class="divider"></div>
          <button onclick="adminLogout()" class="text-danger"><i class="fa-solid fa-right-from-bracket"></i>Logout</button>
        </div>
      </div>
    </div>
  </header>
            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                
  <main class="admin-main">
    <div class="admin-content">
      <div class="page-header">
        <div><h1>Dashboard</h1><div class="breadcrumb-nav">Welcome back, Admin! Here's your restaurant overview.</div></div>
        <div style="display:flex;gap:.5rem">
          <button class="btn-admin btn-admin-outline"><i class="fa-solid fa-download"></i>Export</button>
          <button class="btn-admin btn-admin-primary"><i class="fa-solid fa-plus"></i>New Order</button>
        </div>
      </div>

      <!-- Stats -->
      <div class="gap-grid grid-6" style="margin-bottom:1.5rem">
        <div class="admin-card stat-card">
          <div class="stat-icon primary"><i class="fa-solid fa-indian-rupee-sign"></i></div>
          <div class="stat-info"><h4>₹4,52,800</h4><p>Total Revenue</p><div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> 12.5%</div></div>
        </div>
        <div class="admin-card stat-card">
          <div class="stat-icon info"><i class="fa-solid fa-bag-shopping"></i></div>
          <div class="stat-info"><h4>1,248</h4><p>Total Orders</p><div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> 8.2%</div></div>
        </div>
        <div class="admin-card stat-card">
          <div class="stat-icon success"><i class="fa-solid fa-users"></i></div>
          <div class="stat-info"><h4>856</h4><p>Total Customers</p><div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> 5.1%</div></div>
        </div>
        <div class="admin-card stat-card">
          <div class="stat-icon warning"><i class="fa-solid fa-utensils"></i></div>
          <div class="stat-info"><h4>64</h4><p>Food Items</p><div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> 3</div></div>
        </div>
        <div class="admin-card stat-card">
          <div class="stat-icon purple"><i class="fa-solid fa-clock"></i></div>
          <div class="stat-info"><h4>23</h4><p>Pending Orders</p><div class="stat-trend down"><i class="fa-solid fa-arrow-down"></i> 2.4%</div></div>
        </div>
        <div class="admin-card stat-card">
          <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
          <div class="stat-info"><h4>1,180</h4><p>Completed</p><div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> 9.8%</div></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:1.25rem;margin-bottom:1.5rem">
        <!-- Revenue Chart -->
        <div class="admin-card">
          <div class="card-header-admin">
            <h3><i class="fa-solid fa-chart-line" style="color:#ff5a1f;margin-right:.4rem"></i>Revenue Overview</h3>
            <div class="chart-tabs">
              <button class="chart-tab active" onclick="switchChartTab(this,()=>drawLineChart('revenueChart',['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],[4200,5800,3900,7200,6100,8900,7400],'#ff5a1f'))">This Week</button>
              <button class="chart-tab" onclick="switchChartTab(this,()=>drawLineChart('revenueChart',['Wk1','Wk2','Wk3','Wk4'],[28000,35000,31000,42000],'#ff5a1f'))">This Month</button>
              <button class="chart-tab" onclick="switchChartTab(this,()=>drawBarChart('revenueChart',['Jan','Feb','Mar','Apr','May','Jun'],[85000,92000,78000,105000,98000,115000],'#ff5a1f'))">This Year</button>
            </div>
          </div>
          <div class="card-body-admin"><div class="chart-container"><canvas id="revenueChart"></canvas></div></div>
        </div>
        <!-- Orders Pie -->
        <div class="admin-card">
          <div class="card-header-admin"><h3><i class="fa-solid fa-chart-pie" style="color:#6f42c1;margin-right:.4rem"></i>Orders Overview</h3></div>
          <div class="card-body-admin"><div class="chart-container"><canvas id="ordersPieChart"></canvas></div></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:1.25rem">
        <!-- Recent Orders -->
        <div class="admin-card">
          <div class="card-header-admin">
            <h3>Recent Orders</h3>
            <a href="orders.aspx" class="btn-admin btn-admin-outline btn-admin-sm">View All</a>
          </div>
          <div class="table-responsive-admin">
            <table class="admin-table">
              <thead><tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Amount</th><th>Status</th><th>Date</th><th>Action</th></tr></thead>
              <tbody id="recentOrdersBody"></tbody>
            </table>
          </div>
        </div>

        <!-- Top Selling + Recent Customers -->
        <div style="display:flex;flex-direction:column;gap:1.25rem">
          <div class="admin-card">
            <div class="card-header-admin"><h3>Top Selling</h3></div>
            <div class="card-body-admin">
              <div style="display:flex;flex-direction:column;gap:.85rem" id="topSellingList"></div>
            </div>
          </div>
          <div class="admin-card">
            <div class="card-header-admin"><h3>Recent Customers</h3></div>
            <div class="card-body-admin">
              <div style="display:flex;flex-direction:column;gap:.85rem" id="recentCustomersList"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
                
  <div id="adminToast" class="admin-toast"></div>
  
  <script src="js/admin.js"></script>
  <script>
    // Populate recent orders
    document.getElementById('recentOrdersBody').innerHTML=demoOrders.slice(0,6).map(o=>`<tr>
      <td class="fw-600">${o.id}</td>
      <td><div class="table-user"><img src="${o.avatar}" alt="">${o.customer}</div></td>
      <td class="fs-sm">${o.items}</td><td class="fw-600">${o.amount}</td>
      <td>${statusBadge(o.status)}</td><td class="fs-sm">${o.date}</td>
      <td><a href="order-details.aspx" class="btn-admin btn-admin-outline btn-admin-sm">View</a></td>
    </tr>`).join('');

    // Top selling
    const topFoods=[
      {name:'Pepperoni Pizza',cat:'Pizza',orders:95,rev:'₹28,405',img:'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=80&q=80'},
      {name:'Hyderabadi Biryani',cat:'Biryani',orders:88,rev:'₹26,312',img:'https://images.unsplash.com/photo-1589302168068-964664d93dc0?auto=format&fit=crop&w=80&q=80'},
      {name:'Smoky Burger',cat:'Burger',orders:72,rev:'₹17,928',img:'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=80&q=80'}
    ];
    document.getElementById('topSellingList').innerHTML=topFoods.map(f=>`<div style="display:flex;align-items:center;gap:.75rem">
      <img src="${f.img}" style="width:44px;height:44px;border-radius:.5rem;object-fit:cover">
      <div style="flex:1"><div class="fw-600 fs-sm">${f.name}</div><div style="font-size:.72rem;color:#6c757d">${f.cat} • ${f.orders} orders</div></div>
      <div class="fw-600 fs-sm text-primary-admin">${f.rev}</div>
    </div>`).join('');

    // Recent customers
    document.getElementById('recentCustomersList').innerHTML=demoCustomers.slice(0,4).map(c=>`<div style="display:flex;align-items:center;gap:.75rem">
      <img src="${c.avatar}" style="width:36px;height:36px;border-radius:50%;object-fit:cover">
      <div style="flex:1"><div class="fw-600 fs-sm">${c.name}</div><div style="font-size:.72rem;color:#6c757d">${c.email}</div></div>
      <div style="font-size:.72rem;color:#6c757d">${c.joined}</div>
    </div>`).join('');
  </script>
</body>
</html>

            </asp:ContentPlaceHolder>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
